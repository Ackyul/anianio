# Claves de Binance (NUNCA subas el archivo .env a git ni lo compartas)
# Para Futures (Long + Short), habilita "Enable Futures" y "Enable Reading",
# restringida a tu IP. NUNCA actives retiros (Enable Withdrawals).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Claves de Binance Testnet para probar sin dinero real
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Telegram (para consultar desde iPhone/celular) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mercado ---
MARKET_TYPE=futures
LEVERAGE=1
ALLOW_SHORT=true

# --- Capital y riesgo ---
PAPER_CAPITAL=1000.0
MAX_CAPITAL=100.0
RISK_PER_TRADE=0.01
MAX_POSITIONS=4
MAX_POSITION_PCT=0.25
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.20

# --- Universo y estrategia ---
UNIVERSE_SIZE=40
MIN_QUOTE_VOLUME=50000000
TOP_N_RANK=8
